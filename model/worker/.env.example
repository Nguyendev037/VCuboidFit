# Worker KHÔNG tự đọc file này - đặt biến trong shell (PowerShell: $env:WORKSPACE="...").
# Thư mục dữ liệu chạy (uploads/ datasets/ jobs/). Web PHẢI trỏ cùng thư mục này.
# Mặc định tương đối theo thư mục chạy uvicorn: chạy trong model/worker => model/workspace.
WORKSPACE=../workspace
# 7-Zip để giải nén .7z/.rar; .zip không cần.
SEVENZIP_PATH=7z
# Cấu hình phần cứng: local-4060 (mặc định) hoặc cloud
C4_PROFILE=local-4060
# Thư mục trọng số YOLO/DINOv2/OpenCLIP (cần cho rare_v24 profile multisensor; tải bằng model/scripts/fetch_weights.py).
# Mặc định: model/workspace/weights. Chế độ giả lập (test): C4_FAKE_MODELS
# C4_WEIGHTS_DIR=
# C4_FAKE_MODELS=1
# Cổng worker (web và tunnel đọc cùng biến này)
VCF_PORT=8001
# Cầu nối Tầng 1 từ xa (Colab). Rỗng = tắt: mọi /remote/* trả 404.
VCF_REMOTE_TOKEN=
# Hạn giữ việc (giây) trước khi trả về hàng đợi
VCF_REMOTE_LEASE_SEC=5400
# Kích thước tối đa kết quả Colab tải lên (MB)
VCF_REMOTE_MAX_RESULT_MB=200
# Engine mặc định khi request /jobs/{id}/select không gửi engineVersion: c4_legacy (mặc định) hoặc rare_v24
# VCF_ENGINE_DEFAULT=c4_legacy
# Thí nghiệm có seed Tầng 1 (index.parquet, t1/cfg/pp_seed.yaml, t1/ckpt/seed_latest.pth); none = tắt. Bỏ trống = tự dò model/workspace/experiments
# VCF_T1_EXP=
