flowchart TD
    A[("Kho LiDAR thô<br/>chưa gán nhãn")] --> M0["M0 Chuẩn hoá<br/>keyframes · chia V/T theo scene"]
    MODEL["Model LÕI<br/>PointPillars công khai, đóng băng"] -.-> M05a
    SEED["Bước 0 TUỲ CHỌN<br/>train model Seed"]:::opt -.-> M05a
    M0 --> M05a{"M0.5a Sanity<br/>model đủ tốt?"}
    M05a -- "FAIL: sửa adapter" --> M05a
    M05a -- PASS --> M05b{"M0.5b Pilot<br/>yield ≥ 1.2× random?"}
    M05b -- "NO-GO: xem lại" --> M05a
    M05b -- GO --> M1["M1 Sinh ứng viên vật thể<br/>clustering + PointPillars + TTA"]
    M1 --> GATE{"Cổng NGOẠI LAI<br/>4 phép thử"}:::gate
    GATE -- "Hợp lệ" --> M2["M2 Điểm VẬT THỂ<br/>hình dạng hiếm · không chắc · điểm yếu · giống VRU"]
    GATE -- "Nghi ngờ" --> REV["review_T.csv<br/>người duyệt"]:::gate
    GATE -- "Ngoại lai" --> OUT["Loại<br/>không chọn, không train"]:::bad
    M2 --> M3["M3 Điểm FRAME<br/>vật hiếm · đông người · thời tiết<br/>(OOD chỉ là cờ)"]
    M3 --> M4["M4 Dedup + đa dạng hoá<br/>top-2 mỗi nhóm · quota slice"]
    M4 --> M5["M5 Chọn theo ngân sách B<br/>frames_ranked_T.csv + objects_T.csv"]
    M5 --> L["Đội gán nhãn<br/>gán lô selected=1"]
    M5 --> M6["M6 Đánh giá trên GT giấu<br/>so Random cùng chi phí"]
    L --> LEDGER["Ledger: frame đã gán<br/>không bao giờ chọn lại"]
    LEDGER --> M0
    L -. "công tắc retrain" .-> SEED
    classDef gate fill:#fff4d6,stroke:#b7791f,color:#5c3d00
    classDef bad fill:#fde2e2,stroke:#c00000,color:#7a0000
    classDef opt fill:#efe6f7,stroke:#6a3d9a,stroke-dasharray: 5 5,color:#3b1f5c
