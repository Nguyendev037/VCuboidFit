# Sao chép thành .env.local rồi sửa. Next.js tự đọc .env.local khi chạy trong web/.
# Địa chỉ worker FastAPI
WORKER_URL=http://127.0.0.1:8001
# Thư mục dữ liệu chạy, PHẢI trùng với WORKSPACE của worker (tuyệt đối, hoặc tương đối theo web/).
# Nếu bỏ trống, web dùng <repo>/workspace (KHÁC mặc định của worker là model/workspace).
WORKSPACE=../model/workspace
# Dung lượng upload tối đa (GB)
MAX_UPLOAD_GB=100
# Đặt 1 để chạy bằng dữ liệu mẫu, không cần worker
# NEXT_PUBLIC_MOCK=1
# Cổng worker mặc định khi không đặt WORKER_URL (mặc định 8001)
# VCF_PORT=8001
